        <ArticleTitle>[Emphasis on scientific research related to viral hepatitis].</ArticleTitle>
        <Pagination>
          <StartPage>1</StartPage>
          <EndPage>2</EndPage>
          <MedlinePgn>1-2</MedlinePgn>
